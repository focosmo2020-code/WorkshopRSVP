@model List<RSVP>
@{
	ViewData["Title"] = "Workshop Registrations";
}
<h1>All <Registrations></h1>
<p>Total Registrations: <strong>@Model.Count</strong></p>

@if (Model.Count == 0)
{
	<div class="alert alert-info">No Registrations Found</div>
}
else
{
	<table class="table table-striped table-boardered">
		<thead class="table-dark">
			<tr>
				<th>#</th>
				<th>Full Name</th>
				<th>Workshop</th>
				<th>Needs Accommodation</th>
			</tr>
		</thead>
		<tbody>
			@for (int i = 0; i < Model.Count; i++)
			{
				<tr>
					<td>@(i + 1)</td>
					<td>@Model[i].FullName</td>
					<td>@Model[i].WorkshopName</td>
					<td>@(Model[i].NeedsAccommodation ? "Yes" : "No")</td>
				</tr>
			}
		</tbody>
	</table>
}