@model RSVP

@{
    ViewData["Title"] = "Tech Workshop Registration";
    var workshop = ViewData["Workshop"] as List<string> ?? new List<string>();
}

<h1>Tech Workshop Registration</h1>
<p>Join us for cutting-edge .NET and software development workshops</p>

<form asp-controller="Workshop" asp-action="Confirm" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Full Name</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="WorkshopName" class="form-label">Select Workshop</label>
        <select asp-for="WorkshopName" class="form-select">
            <option value="">-- Choose a workshop --</option>
            @foreach (var w in workshop)
            {
                <option value="@w">@w</option>
            }
        </select>
        <span asp-validation-for="WorkshopName" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="NeedsAccommodation" class="form-check-input" />
        <label asp-for="NeedsAccommodation" class="form-check-label">
            I need accommodation
        </label>
    </div>

    <button type="submit" class="btn btn-primary">Register Now</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

